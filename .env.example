# Copy to apps/<app>/.env.local (Vite reads env files from each app's folder).
# Every value here is public: it ships in the browser bundle. Never put secrets in VITE_*.

# Product name shown in the UI and page titles. "Grov" is a working name (D65).
VITE_BRAND_NAME=Grov

# grov-be base URL, without /v1. Local: http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# Must match grov-be's cookie prefix (BRAND_NAME slugified: "Grov" -> "grov").
# The CSRF cookie the web clients echo is `<prefix>_csrf` (app) or `<prefix>_admin_csrf` (admin).
VITE_COOKIE_PREFIX=grov

# Google Identity Services web client id. Leave empty to hide "Continue with Google".
VITE_GOOGLE_CLIENT_ID=

# Cross-links between the apps.
VITE_APP_URL=http://localhost:4300
VITE_WEBSITE_URL=http://localhost:4200

# Component gallery at /design-system. Always on in `yarn dev:*`; set to true to include it in a build.
VITE_SHOW_DESIGN_SYSTEM=false
